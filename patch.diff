+  // 标签必须写成累计，否则读者会把 by_window 的分档数（day / week / month）当成累计值比对而怀疑数据。
+  var TH_WIN_CN={all:'全部',day:'当日',week:'近 7 天（含当日）',month:'近 30 天（含前两档）'};
+  var TH_HEAT_CN={all:'全部',hot:'🔥🔥🔥 高热',mid:'🔥🔥 中热+',native:'有原生指标'};
